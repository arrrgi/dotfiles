#
# config/mise/config.toml hash: {{ include (joinPath .chezmoi.sourceDir "dot_config/mise/config.toml.tmpl") | sha256sum }}

set -euo pipefail

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"

brew_prefix="$("${BREW_PATH}" --prefix)"
mise_bin="${brew_prefix}/bin/mise"

if [ ! -x "${mise_bin}" ]; then
  printf 'Error: mise is not installed at %s.\n' "${mise_bin}" >&2
  exit 1
fi

printf 'Info: Installing globally configured mise tools.\n'
"${mise_bin}" install
printf 'Info: mise tool installations completed.\n'
