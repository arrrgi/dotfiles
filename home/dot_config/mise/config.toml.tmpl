[settings]
terminal_progress = true

{{- if .target.wsl }}
[settings.node]
gpg_verify = false
{{- end }}

[env]
{{- if lookPath "dcg" }}
DCG_ROBOT = "1"
{{- end }}
{{- if lookPath "claude" }}
_.path = [
    "{{ `{{ env.XDG_CONFIG_HOME }}` }}/claude/plugins/marketplaces/flow-next/plugins/flow-next/scripts"
]
{{- end }}

[tools]
fnox = "latest"
hk = "latest"
pkl = "latest"
uv = "latest"
